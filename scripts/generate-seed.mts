// Builds supabase/seed.sql from src/content/seed.ts.  Run: npm run seed:sql
// Every insert uses "on conflict do nothing", so running seed.sql again never overwrites edits made in the dashboard.
import { writeFileSync } from 'node:fs';
import { seed } from '../src/content/seed.ts';

const TEXT_ARRAYS = new Set(['stack', 'gallery', 'doors']);
const q = (s: string) => `'${s.replace(/'/g, "''")}'`;

function lit(key: string, v: unknown): string {
  if (v === null || v === undefined) return 'null';
  if (typeof v === 'boolean') return v ? 'true' : 'false';
  if (typeof v === 'number') return String(v);
  if (TEXT_ARRAYS.has(key)) return (v as string[]).length ? `array[${(v as string[]).map(q).join(', ')}]::text[]` : `'{}'::text[]`;
  if (typeof v === 'string') return q(v);
  return `${q(JSON.stringify(v))}::jsonb`;
}

function insert(table: string, rows: Record<string, unknown>[], pk: string) {
  return rows.map(r => {
    const cols = Object.keys(r);
    return `insert into public.${table} (${cols.join(', ')}) values (${cols.map(c => lit(c, r[c])).join(', ')}) on conflict (${pk}) do nothing;`;
  }).join('\n');
}

const out = [
  '-- Starting content. Generated by scripts/generate-seed.mts from src/content/seed.ts. Run after schema.sql.',
  'begin;',
  insert('profile', [seed.profile as unknown as Record<string, unknown>], 'id'),
  insert('sections', seed.sections as unknown as Record<string, unknown>[], 'key'),
  insert('doors', seed.doors as unknown as Record<string, unknown>[], 'id'),
  insert('projects', seed.projects as unknown as Record<string, unknown>[], 'id'),
  insert('experiences', seed.experiences as unknown as Record<string, unknown>[], 'id'),
  insert('activities', seed.activities as unknown as Record<string, unknown>[], 'id'),
  insert('achievements', seed.achievements as unknown as Record<string, unknown>[], 'id'),
  insert('education', seed.education as unknown as Record<string, unknown>[], 'id'),
  insert('skill_groups', seed.skillGroups as unknown as Record<string, unknown>[], 'id'),
  insert('skills', seed.skills as unknown as Record<string, unknown>[], 'id'),
  'commit;',
  ''
].join('\n\n');

writeFileSync(new URL('../supabase/seed.sql', import.meta.url), out);
console.log(`supabase/seed.sql written (${out.length.toLocaleString()} characters)`);
