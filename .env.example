# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API (or Data API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key. It is safe in the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Public address of the site, used for SEO links and password-reset emails.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional: a long random string. Vercel sends it with the daily keep-alive cron call.
CRON_SECRET=
